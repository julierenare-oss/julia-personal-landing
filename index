</footer>

<div class="mobile-cta-bar">
  <a href="#contact" class="btn btn-primary" data-analytics="click_primary_cta" data-analytics-place="mobile_bar">Обсудить задачу</a>
</div>

<script>
/* ============================================================
   Analytics event layer — независимый от конкретной системы.
   Подключить Яндекс.Метрику или другую аналитику: раскомментировать
   вызов внутри analytics.track() и передать реальный ID счётчика.
============================================================ */
window.analytics = {
  track: function (eventName, payload) {
    // TODO: подключить реальную систему аналитики, например:
    // if (window.ym) ym(COUNTER_ID, 'reachGoal', eventName, payload);
    // if (window.gtag) gtag('event', eventName, payload);
    if (window.dataLayer) { window.dataLayer.push(Object.assign({ event: eventName }, payload)); }
    console.debug('[analytics]', eventName, payload || {});
  }
};

document.addEventListener('click', function (e) {
  var el = e.target.closest('[data-analytics]');
  if (!el) return;
  window.analytics.track(el.getAttribute('data-analytics'), { place: el.getAttribute('data-analytics-place') || null });
});

/* Scroll reveal */
var io = new IntersectionObserver(function (entries) {
  entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
}, { threshold: 0.08 });
document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });

/* Mobile nav */
var navToggle = document.getElementById('navToggle');
var navPanel = document.getElementById('navMobilePanel');
navToggle.addEventListener('click', function () {
  var open = navPanel.classList.toggle('open');
  navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
});
navPanel.querySelectorAll('a').forEach(function (a) {
  a.addEventListener('click', function () { navPanel.classList.remove('open'); navToggle.setAttribute('aria-expanded', 'false'); });
});

/* Formats accordion */
document.querySelectorAll('.fmt-item').forEach(function (item) {
  var btn = item.querySelector('.fmt-btn');
  btn.addEventListener('click', function () {
    var isOpen = item.getAttribute('data-open') === 'true';
    document.querySelectorAll('.fmt-item').forEach(function (i) {
      i.setAttribute('data-open', 'false');
      i.querySelector('.fmt-btn').setAttribute('aria-expanded', 'false');
    });
    if (!isOpen) {
      item.setAttribute('data-open', 'true');
      btn.setAttribute('aria-expanded', 'true');
      window.analytics.track('click_service', { place: btn.textContent.trim() });
    }
  });
});

/* Footer year */
document.getElementById('ftYear').textContent = new Date().getFullYear();

/* ============================================================
   LEAD FORM
   ----------------------------------------------------------
   TODO для владельца сайта: указать реальный endpoint формы
   (например, Formspree / Getform / собственная serverless-функция)
   в константе FORM_ENDPOINT ниже. Пока значение не задано,
   форма собирает данные и открывает почтовый клиент со
   сформированным письмом — реальная отправка происходит только
   после того, как пользователь нажмёт "отправить" в своей почте.
   Как только endpoint подключён, замените FORM_ENDPOINT и
   удалите ветку с mailto-fallback ниже.
============================================================ */
var FORM_ENDPOINT = ''; // TODO: например 'https://formspree.io/f/XXXXXXX'
var FALLBACK_EMAIL = 'hello@jrybakova.tech'; // TODO: подтвердить, что адрес активен

(function () {
  var form = document.getElementById('leadForm');
  var status = document.getElementById('formStatus');

  function setError(fieldId, message) {
    var el = form.querySelector('[data-error-for="' + fieldId + '"]');
    var field = document.getElementById(fieldId);
    if (el) el.textContent = message || '';
    if (field) field.closest('.form-field').classList.toggle('error', !!message);
  }

  function validate(data) {
    var valid = true;
    setError('f-name', ''); setError('f-contact', ''); setError('f-task', ''); setError('f-desc', '');

    if (!data.name.trim()) { setError('f-name', 'Укажите имя'); valid = false; }
    if (!data.contact.trim()) { setError('f-contact', 'Укажите почту или Telegram'); valid = false; }
    else {
      var isEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.contact.trim());
      var isTg = /^@?[\w\d_]{4,}$/.test(data.contact.trim());
      if (!isEmail && !isTg) { setError('f-contact', 'Введите корректную почту или Telegram-ник'); valid = false; }
    }
    if (!data.task_type) { setError('f-task', 'Выберите тип задачи'); valid = false; }
    if (!data.description.trim() || data.description.trim().length < 10) { setError('f-desc', 'Опишите ситуацию чуть подробнее (от 10 символов)'); valid = false; }
    if (!data.consent) { valid = false; }
    if (data.website) { valid = false; } // honeypot triggered

    return valid;
  }

  function showStatus(type, text) {
    status.className = 'form-status show ' + type;
    status.textContent = text;
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    window.analytics.track('form_start', {});

    var fd = new FormData(form);
    var data = Object.fromEntries(fd.entries());
    data.consent = !!fd.get('consent');

    if (!validate(data)) {
      window.analytics.track('form_error', { reason: 'validation' });
      showStatus('err', 'Проверьте, пожалуйста, заполнение обязательных полей.');
      return;
    }

    var submitBtn = form.querySelector('button[type="submit"]');
    submitBtn.disabled = true;

    if (FORM_ENDPOINT) {
      fetch(FORM_ENDPOINT, {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      }).then(function (res) {
        submitBtn.disabled = false;
        if (res.ok) {
          window.analytics.track('form_submit', {});
          window.analytics.track('form_success', {});
          form.reset();
          showStatus('ok', 'Спасибо. Я изучу описание задачи и свяжусь с вами, чтобы задать уточняющие вопросы или предложить время для разговора.');
        } else {
          window.analytics.track('form_error', { reason: 'server' });
          showStatus('err', 'Не получилось отправить заявку. Попробуйте ещё раз или напишите в Telegram: @IuliiaRybakova.');
        }
      }).catch(function () {
        submitBtn.disabled = false;
        window.analytics.track('form_error', { reason: 'network' });
        showStatus('err', 'Не получилось отправить заявку. Попробуйте ещё раз или напишите в Telegram: @IuliiaRybakova.');
      });
    } else {
      // Fallback: endpoint ещё не подключён — открываем почтовый клиент
      // с готовым письмом. Это не имитация успешной отправки: письмо
      // реально уйдёт, только когда пользователь нажмёт "отправить".
      submitBtn.disabled = false;
      var subject = 'Заявка с сайта: ' + data.task_type;
      var bodyLines = [
        'Имя: ' + data.name,
        'Компания: ' + (data.company || '—'),
        'Должность: ' + (data.role || '—'),
        'Контакт: ' + data.contact,
        'Тип задачи: ' + data.task_type,
        'Описание ситуации: ' + data.description,
        'Желаемый результат: ' + (data.desired_result || '—'),
        'Когда планируется начало: ' + (data.timing || '—')
      ];
      var mailto = 'mailto:' + FALLBACK_EMAIL + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(bodyLines.join('\n'));
      window.analytics.track('form_submit', { channel: 'mailto_fallback' });
      window.location.href = mailto;
      showStatus('ok', 'Форма ещё подключается к почте напрямую. Сейчас откроется ваш почтовый клиент с готовым письмом — нажмите «отправить», чтобы заявка дошла до меня. Также можно написать в Telegram: @IuliiaRybakova.');
    }
  });

  form.querySelectorAll('input, select, textarea').forEach(function (el) {
    el.addEventListener('blur', function () {
      if (el.id === 'f-name' && !el.value.trim()) setError('f-name', 'Укажите имя');
      else if (el.id) setError(el.id, '');
    });
  });
})();
</script>
</body>
</html>
