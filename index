          <!-- TODO: заменить на действующий адрес после подключения корпоративной почты -->
          <!-- <a href="mailto:hello@jrybakova.tech">hello@jrybakova.tech</a> -->
        </div>
        <div class="ft-col">
          <div class="ft-col-title">Правовая информация</div>
          <a href="/privacy.html">Политика конфиденциальности</a>
          <a href="/consent.html">Согласие на обработку ПД</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© <span id="ftYear">2026</span> Юлия Рыбакова</span>
      <span>Сайт не использует cookie-трекинг сторонних рекламных сетей</span>
    </div>
