<style>
/* ============================================================
   Юлия Рыбакова — jrybakova.tech
   Общая таблица стилей для всех страниц сайта
============================================================ */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

:root {
  --bg:       #0A0908;
  --bg2:      #111009;
  --bg3:      #161410;
  --ivory:    #EDE8DF;
  --dim:      #9A9284;
  --dim2:     #7A7468;
  --faint:    rgba(237,232,223,0.06);
  --line:     rgba(237,232,223,0.11);
  --amber:    #C4813F;
  --amber2:   #D8975A;
  --amber-bg: rgba(196,129,63,0.10);
  --serif:    'Cormorant Garamond', Georgia, serif;
  --sans:     'Inter', system-ui, -apple-system, sans-serif;
  --focus:    #E6B37E;
  --maxw:     1200px;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important; scroll-behavior: auto !important; }
}

html { scroll-behavior: smooth; }
body {
  background: var(--bg); color: var(--ivory); font-family: var(--sans);
  font-weight: 300; font-size: 16px; line-height: 1.7;
  -webkit-font-smoothing: antialiased; overflow-x: hidden;
}
img { max-width: 100%; display: block; }
a { color: inherit; }
ul { list-style: none; }

/* ── ACCESSIBILITY ── */
.skip-link {
  position: absolute; left: -9999px; top: 0; z-index: 999;
  background: var(--amber); color: var(--bg); padding: 14px 22px;
  font-size: 13px; letter-spacing: .04em; text-decoration: none;
}
.skip-link:focus { left: 16px; top: 16px; }

:focus-visible {
  outline: 2px solid var(--focus); outline-offset: 3px;
}
a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible {
  outline: 2px solid var(--focus); outline-offset: 3px;
}

.visually-hidden {
  position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
}

/* ── UTILS ── */
.serif      { font-family: var(--serif); }
.amber      { color: var(--amber); }
.dim        { color: var(--dim); }
.container  { max-width: var(--maxw); margin: 0 auto; padding: 0 48px; }
.container-narrow { max-width: 760px; margin: 0 auto; padding: 0 48px; }
.eyebrow    { font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--amber); display: flex; align-items: center; gap: 10px; }
.eyebrow::before { content:''; display:block; width:28px; height:1px; background: var(--amber); flex-shrink:0; }
h1,h2,h3 { font-weight: 400; }
h2.title, h1.title    { font-family: var(--serif); font-size: clamp(2.1rem, 3.6vw, 3.2rem); font-weight: 300; line-height: 1.15; letter-spacing: -.01em; margin-top: 1.1rem; }
h2.title em, h1.title em { font-style: italic; color: var(--amber2); }
h3.subtitle { font-family: var(--serif); font-size: 1.5rem; font-weight: 400; line-height: 1.3; margin-bottom: .6rem; }
p.lead { font-size: 1.02rem; color: var(--dim); line-height: 1.8; }

.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 10px;
  font-size: 12px; font-weight: 500; letter-spacing: .12em; text-transform: uppercase;
  padding: 15px 28px; text-decoration: none; border: 1px solid transparent;
  cursor: pointer; transition: background .2s, border-color .2s, color .2s;
  min-height: 48px;
}
.btn-primary { background: var(--amber); color: var(--bg); }
.btn-primary:hover { background: var(--amber2); }
.btn-secondary { color: var(--ivory); border-color: var(--line); background: transparent; }
.btn-secondary:hover { border-color: var(--amber); color: var(--amber); }
.btn-ghost { color: var(--amber); border-color: var(--amber); background: transparent; }
.btn-ghost:hover { background: var(--amber); color: var(--bg); }
.btn svg { width: 15px; height: 15px; fill: currentColor; flex-shrink: 0; }

/* ── ANIMATIONS (subtle, respect reduced-motion) ── */
.reveal { opacity:0; transform:translateY(20px); transition: opacity .55s ease, transform .55s ease; }
.reveal.in { opacity:1; transform:translateY(0); }
.reveal-d1 { transition-delay: .08s; }
.reveal-d2 { transition-delay: .16s; }
.reveal-d3 { transition-delay: .24s; }
@media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; } }

/* ════════════════════════════════
   NAV
════════════════════════════════ */
nav.site-nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 500;
  display: flex; align-items: center; justify-content: space-between;
  padding: 18px 48px;
  border-bottom: 1px solid var(--line);
  backdrop-filter: blur(18px) saturate(120%);
  background: rgba(10,9,8,.82);
}
.nav-logo {
  font-family: var(--serif); font-size: 1.1rem; font-weight: 400;
  letter-spacing: .04em; color: var(--ivory); text-decoration: none;
}
.nav-logo .role { display:block; font-family: var(--sans); font-size: 9px; letter-spacing: .14em; text-transform: uppercase; color: var(--dim2); margin-top: 2px; }
.nav-links { display:flex; gap:30px; align-items: center; }
.nav-links a {
  font-size: 11px; letter-spacing: .12em; text-transform: uppercase;
  color: var(--dim); text-decoration: none; transition: color .2s;
}
.nav-links a:hover, .nav-links a:focus-visible { color: var(--ivory); }
.nav-cta {
  font-size: 11px; letter-spacing: .1em; text-transform: uppercase;
  color: var(--bg); background: var(--amber);
  padding: 10px 20px; text-decoration: none; transition: background .2s;
  white-space: nowrap;
}
.nav-cta:hover { background: var(--amber2); }
.nav-toggle {
  display: none; background: none; border: 1px solid var(--line); color: var(--ivory);
  width: 42px; height: 42px; align-items: center; justify-content: center;
}
.nav-mobile-panel { display: none; }

@media (max-width: 980px) {
  nav.site-nav { padding: 14px 20px; }
  .nav-links { display: none; }
  .nav-toggle { display: flex; }
  .nav-cta.desktop-only { display: none; }
  .nav-mobile-panel {
    position: fixed; top: 66px; left: 0; right: 0; bottom: 0; z-index: 490;
    background: var(--bg); padding: 24px 20px; display: none; flex-direction: column; gap: 4px;
    overflow-y: auto;
  }
  .nav-mobile-panel.open { display: flex; }
  .nav-mobile-panel a {
    padding: 16px 4px; border-bottom: 1px solid var(--line);
    font-size: 15px; text-decoration: none; color: var(--ivory);
  }
  .nav-mobile-panel .btn { margin-top: 16px; }
}

/* Skip mobile sticky CTA bar */
.mobile-cta-bar {
  display: none;
}
@media (max-width: 980px) {
  .mobile-cta-bar {
    display: flex; position: fixed; bottom: 0; left: 0; right: 0; z-index: 480;
    background: rgba(10,9,8,.94); backdrop-filter: blur(10px);
    border-top: 1px solid var(--line); padding: 10px 16px;
    padding-bottom: max(10px, env(safe-area-inset-bottom));
  }
  .mobile-cta-bar .btn { width: 100%; }
  body { padding-bottom: 66px; }
}

/* ════════════════════════════════
   HERO
════════════════════════════════ */
.hero {
  min-height: 92vh;
  display: flex; flex-direction: column; justify-content: center;
  padding: 140px 0 60px;
  position: relative; overflow: hidden;
}
.hero-glow {
  position:absolute; top:-25%; right:-15%; width:60%; height:90%;
  background: radial-gradient(ellipse at center, rgba(196,129,63,.08) 0%, transparent 65%);
  pointer-events:none;
}
.hero-route {
  position:absolute; bottom: 6%; left: 0; right: 0; height: 40%;
  opacity: .35; pointer-events: none;
}
.hero-eyebrow-line { font-size: 13px; letter-spacing: .1em; color: var(--dim); margin-bottom: 22px; }
.hero-eyebrow-line strong { color: var(--amber); font-weight: 500; }
.hero-title {
  font-family: var(--serif); font-weight: 300;
  font-size: clamp(2.1rem, 4.6vw, 3.7rem); line-height: 1.18; letter-spacing: -.01em;
  max-width: 920px; margin-bottom: 26px; position: relative; z-index: 1;
}
.hero-sub { font-size: clamp(1rem, 1.6vw, 1.15rem); color: var(--dim); max-width: 640px; line-height: 1.75; margin-bottom: 18px; position: relative; z-index: 1; }
.hero-sub2 { font-size: .93rem; color: var(--dim2); max-width: 640px; line-height: 1.7; margin-bottom: 40px; position: relative; z-index: 1; }
.hero-btns { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; position: relative; z-index: 1; margin-bottom: 44px; }
.hero-tg-link {
  display: inline-flex; align-items: center; gap: 8px; font-size: 12px; letter-spacing: .06em;
  color: var(--dim); text-decoration: none; transition: color .2s; position: relative; z-index: 1;
}
.hero-tg-link:hover { color: var(--amber); }
.hero-tg-link svg { width: 15px; height: 15px; fill: currentColor; }

.hero-facts { display: flex; flex-wrap: wrap; gap: 0; border-top: 1px solid var(--line); position: relative; z-index: 1; }
.hf-item { padding: 22px 28px 22px 0; margin-right: 28px; border-right: 1px solid var(--line); }
.hf-item:last-child { border-right: none; }
.hf-n { font-family: var(--serif); font-size: 1.9rem; color: var(--ivory); line-height: 1; }
.hf-n sup { color: var(--amber); font-size: 1.05rem; }
.hf-l { font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--dim2); margin-top: 6px; max-width: 130px; line-height: 1.4; }

@media (max-width: 700px) {
  .hero { padding: 110px 0 40px; min-height: auto; }
  .hf-item { padding: 16px 18px 16px 0; margin-right: 14px; }
  .hf-n { font-size: 1.5rem; }
}

/* ════════════════════════════════
   CREDENTIAL STRIP (static, no motion)
════════════════════════════════ */
.cred-strip { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--bg2); padding: 26px 0; }
.cred-row { display: flex; flex-wrap: wrap; gap: 10px 34px; justify-content: center; }
.cred-item { font-family: var(--serif); font-style: italic; font-size: .98rem; color: var(--dim2); white-space: nowrap; }

/* ════════════════════════════════
   SECTION SHELL
════════════════════════════════ */
.section { padding: 96px 0; }
.section-alt { background: var(--bg2); }
.section-head { max-width: 720px; margin-bottom: 52px; }
.section-head p.lead { margin-top: 18px; max-width: 600px; }

/* ════════════════════════════════
   SITUATION CARDS (Block 2)
════════════════════════════════ */
.sit-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); }
.sit-card { background: var(--bg); padding: 34px 30px; }
.sit-num { font-family: var(--serif); font-size: 2.6rem; color: rgba(237,232,223,.08); line-height: 1; margin-bottom: 10px; }
.sit-title { font-family: var(--serif); font-size: 1.22rem; color: var(--ivory); line-height: 1.35; margin-bottom: 10px; }
.sit-text { font-size: .87rem; color: var(--dim); line-height: 1.6; }
@media (max-width: 900px) { .sit-grid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 600px) { .sit-grid { grid-template-columns: 1fr; } }

/* ════════════════════════════════
   DIRECTIONS (Block 3)
════════════════════════════════ */
.dir-list { display: flex; flex-direction: column; }
.dir-row { display: grid; grid-template-columns: 260px 1fr; gap: 40px; padding: 34px 0; border-top: 1px solid var(--line); }
.dir-row:last-child { border-bottom: 1px solid var(--line); }
.dir-title { font-family: var(--serif); font-size: 1.5rem; color: var(--ivory); line-height: 1.25; }
.dir-body p { font-size: .93rem; color: var(--dim); line-height: 1.7; max-width: 620px; margin-bottom: 12px; }
.dir-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
.dir-tag { font-size: 11px; color: var(--dim2); border: 1px solid var(--line); padding: 5px 12px; }
@media (max-width: 760px) { .dir-row { grid-template-columns: 1fr; gap: 12px; } }

/* ════════════════════════════════
   FORMATS (Block 4)
════════════════════════════════ */
.fmt-list { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
.fmt-item { border-bottom: 1px solid var(--line); }
.fmt-btn {
  width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 20px;
  background: none; border: none; color: var(--ivory); text-align: left; cursor: pointer;
  padding: 26px 0; font-family: var(--serif); font-size: 1.25rem;
}
.fmt-btn:hover { color: var(--amber2); }
.fmt-idx { font-family: var(--sans); font-size: 11px; color: var(--amber); letter-spacing: .1em; margin-right: 14px; }
.fmt-chevron { flex-shrink: 0; width: 18px; height: 18px; fill: none; stroke: var(--dim); stroke-width: 1.5; transition: transform .25s; }
.fmt-item[data-open="true"] .fmt-chevron { transform: rotate(180deg); stroke: var(--amber); }
.fmt-panel { max-height: 0; overflow: hidden; transition: max-height .3s ease; }
.fmt-item[data-open="true"] .fmt-panel { max-height: 600px; }
.fmt-panel-inner { padding: 0 0 30px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.fmt-col-label { font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--amber); margin-bottom: 8px; }
.fmt-col-text { font-size: .87rem; color: var(--dim); line-height: 1.6; }
@media (max-width: 760px) { .fmt-panel-inner { grid-template-columns: 1fr; gap: 18px; } .fmt-btn { font-size: 1.05rem; } }

/* ════════════════════════════════
   CASES (Block 5)
════════════════════════════════ */
.case-list { display: flex; flex-direction: column; gap: 2px; }
.case-card { background: var(--bg2); padding: 44px; }
.case-kicker { font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--amber); margin-bottom: 10px; }
.case-h { font-family: var(--serif); font-size: clamp(1.5rem, 2.6vw, 2.1rem); color: var(--ivory); line-height: 1.25; margin-bottom: 28px; max-width: 780px; }
.case-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 26px; }
.case-col-label { font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--dim2); margin-bottom: 8px; }
.case-col-text { font-size: .87rem; color: var(--dim); line-height: 1.65; }
@media (max-width: 900px) { .case-grid { grid-template-columns: 1fr 1fr; } .case-card { padding: 30px 24px; } }
@media (max-width: 560px) { .case-grid { grid-template-columns: 1fr; } }

/* ════════════════════════════════
   WHY ME (Block 6)
════════════════════════════════ */
.why-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: start; }
.why-list { display: flex; flex-direction: column; }
.why-row { display: grid; grid-template-columns: 28px 1fr; gap: 16px; padding: 18px 0; border-bottom: 1px solid var(--line); }
.why-row:first-child { border-top: 1px solid var(--line); }
.why-dash { font-family: var(--serif); color: var(--amber); }
.why-text { font-size: .92rem; color: var(--dim); line-height: 1.6; }
.why-quote {
  font-family: var(--serif); font-style: italic; font-size: 1.5rem; line-height: 1.4;
  color: var(--ivory); border-left: 2px solid var(--amber); padding-left: 26px;
}
@media (max-width: 820px) { .why-grid { grid-template-columns: 1fr; gap: 32px; } }

/* ════════════════════════════════
   ABOUT (Block 7)
════════════════════════════════ */
.about-copy p { font-size: .97rem; color: var(--dim); line-height: 1.8; margin-bottom: 18px; max-width: 560px; }
.about-copy strong { color: var(--ivory); font-weight: 400; }
.about-metaphor {
  margin-top: 30px; background: var(--faint); border-left: 2px solid var(--amber);
  padding: 22px 26px; font-family: var(--serif); font-style: italic; font-size: 1.05rem;
  color: var(--ivory); line-height: 1.6; max-width: 540px;
}

/* ════════════════════════════════
   TEACHING (Block 8)
════════════════════════════════ */
.teach-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 70px; align-items: start; }
.teach-copy p { font-size: .95rem; color: var(--dim); line-height: 1.8; margin-bottom: 16px; max-width: 480px; }
.teach-copy strong { color: var(--ivory); font-weight: 400; }
.edu-list { display: flex; flex-direction: column; }
.edu-row { padding: 20px 0; border-bottom: 1px solid var(--line); }
.edu-row:first-child { border-top: 1px solid var(--line); }
.edu-title { font-family: var(--serif); font-size: 1.05rem; color: var(--ivory); margin-bottom: 4px; }
.edu-org { font-size: .82rem; color: var(--dim); line-height: 1.5; }
@media (max-width: 820px) { .teach-grid { grid-template-columns: 1fr; gap: 32px; } }

/* ════════════════════════════════
   MEDIA / SPEAKING (Block 9)
════════════════════════════════ */
.media-topics { display: flex; flex-wrap: wrap; gap: 10px; margin: 24px 0 32px; }
.media-topic { font-size: .84rem; color: var(--dim); border: 1px solid var(--line); padding: 9px 16px; transition: all .2s; }
.media-topic:hover { border-color: var(--amber); color: var(--amber); }
.media-ctas { display: flex; gap: 14px; flex-wrap: wrap; }

/* ════════════════════════════════
   FINAL CTA + FORM (Block 10)
════════════════════════════════ */
.final-cta { text-align: center; position: relative; overflow: hidden; padding-bottom: 0; }
.fc-blob { position:absolute; inset:0; background: radial-gradient(ellipse 55% 70% at 50% 20%, rgba(196,129,63,.09) 0%, transparent 65%); pointer-events:none; }
.final-cta .section-head { margin: 0 auto 40px; text-align: center; }
.final-cta .eyebrow { justify-content: center; }
.final-cta h2 { margin-left: auto; margin-right: auto; }
.final-cta p.lead { margin-left: auto; margin-right: auto; text-align: center; }

.form-wrap { max-width: 680px; margin: 0 auto; position: relative; z-index: 1; text-align: left; }
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
.form-field { display: flex; flex-direction: column; gap: 8px; }
.form-field.full { grid-column: 1 / -1; }
.form-field label { font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--dim); }
.form-field label .req { color: var(--amber); }
.form-field label .opt { color: var(--dim2); text-transform: none; letter-spacing: 0; font-size: 10px; }
.form-field input, .form-field select, .form-field textarea {
  background: var(--bg2); border: 1px solid var(--line); color: var(--ivory);
  font-family: var(--sans); font-size: .95rem; padding: 13px 14px; width: 100%;
}
.form-field textarea { resize: vertical; min-height: 96px; }
.form-field input:focus, .form-field select:focus, .form-field textarea:focus { border-color: var(--amber); }
.form-field.error input, .form-field.error select, .form-field.error textarea { border-color: #C4573F; }
.field-error { font-size: .78rem; color: #E08A73; min-height: 16px; }
.consent-row { display: flex; align-items: flex-start; gap: 10px; margin: 6px 0 26px; }
.consent-row input[type="checkbox"] { margin-top: 4px; width: 16px; height: 16px; flex-shrink: 0; accent-color: var(--amber); }
.consent-row label { font-size: .82rem; color: var(--dim); line-height: 1.55; text-align: left; }
.consent-row a { color: var(--amber); text-decoration: underline; }
.honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
